# Copy to .env (gitignored) and fill in. Never commit .env.
# Load it into a shell with:  set -a; . ./.env; set +a

# Local development: any values work, but both binaries must use the same ones.
PARTNER_API_KEY=dev
WEBHOOK_SECRET=dev

# Hosted MCP endpoint. deploy/deploy.sh writes it here after each deploy.
# The token in the path is the credential: keep it private.
MCP_URL=
